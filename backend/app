"""Georreferenciamento: validação das coordenadas oficiais + geocodificação de reserva (Nominatim/OSM)."""
import asyncio
import re
import time

import httpx

from .config import Settings


def parse_coord(value) -> float | None:
    """Aceita número, '-8,0476', ' -8.0476 '. Rejeita vazio e 0 (valor típico de 'sem dado')."""
    if value is None:
        return None
    if isinstance(value, (int, float)):
        num = float(value)
    else:
        txt = str(value).strip().replace(",", ".")
        if not re.fullmatch(r"[-+]?\d+(\.\d+)?", txt):
            return None
        num = float(txt)
    return None if num == 0 else num


def _inside(settings: Settings, lat: float, lng: float) -> bool:
    return (
        settings.geo_min_lat <= lat <= settings.geo_max_lat
        and settings.geo_min_lng <= lng <= settings.geo_max_lng
    )


def validate_coords(settings: Settings, lat_raw, lng_raw) -> tuple[float, float] | None:
    """Devolve (lat, lng) válidos para o Recife, corrigindo erros comuns de cadastro:
    sinal perdido e latitude/longitude invertidas. Se nada serve, devolve None."""
    lat, lng = parse_coord(lat_raw), parse_coord(lng_raw)
    if lat is None or lng is None:
        return None
    candidates = [
        (lat, lng),
        (-abs(lat), -abs(lng)),  # sinal perdido
        (lng, lat),  # invertidas
        (-abs(lng), -abs(lat)),
    ]
    for c_lat, c_lng in candidates:
        if _inside(settings, c_lat, c_lng):
            return round(c_lat, 6), round(c_lng, 6)
    return None


class Geocoder:
    """Nominatim (OpenStreetMap) com cache, 1 req/s e limite por sincronização.
    Só é usado para unidades SEM coordenada válida na base oficial."""

    def __init__(self, settings: Settings, db, transport: httpx.AsyncBaseTransport | None = None):
        self.s, self.db, self.transport = settings, db, transport
        self.calls = 0
        self._last = 0.0

    async def geocode(self, address: str, neighborhood: str) -> tuple[float, float] | None:
        if not self.s.geocode_enabled or not address.strip():
            return None
        key = f"{address}|{neighborhood}".lower()
        cached = self.db.geocode_cache_get(key, self.s.geocode_retry_days)
        if cached is not None:
            return cached or None  # () = falha já conhecida
        if self.calls >= self.s.geocode_max_per_sync:
            return None
        self.calls += 1
        wait = 1.1 - (time.monotonic() - self._last)
        if wait > 0:
            await asyncio.sleep(wait)
        self._last = time.monotonic()
        params = {
            "q": f"{address}, {neighborhood}, Recife, PE, Brasil".replace(" ,", ","),
            "format": "jsonv2",
            "limit": 1,
            "countrycodes": "br",
            "viewbox": f"{self.s.geo_min_lng},{self.s.geo_max_lat},{self.s.geo_max_lng},{self.s.geo_min_lat}",
            "bounded": 1,
        }
        try:
            async with httpx.AsyncClient(
                timeout=15, transport=self.transport, headers={"User-Agent": self.s.nominatim_user_agent}
            ) as client:
                resp = await client.get(self.s.nominatim_url, params=params)
                resp.raise_for_status()
                hits = resp.json()
        except (httpx.HTTPError, ValueError):
            return None  # erro transitório: não grava cache negativo
        found = validate_coords(self.s, hits[0].get("lat"), hits[0].get("lon")) if hits else None
        self.db.geocode_cache_put(key, found)
        return found

"""Sincronização: CKAN -> normalização -> geocodificação de reserva -> snapshot no banco."""
import asyncio
import logging

import httpx

from .ckan import fetch_all_records
from .config import Settings
from .db import Database
from .geo import Geocoder
from .normalize import normalize_records

log = logging.getLogger("vemsus.sync")
_lock = asyncio.Lock()


async def run_sync(
    settings: Settings,
    db: Database,
    ckan_transport: httpx.AsyncBaseTransport | None = None,
    geo_transport: httpx.AsyncBaseTransport | None = None,
) -> dict:
    if _lock.locked():
        return {"ok": False, "error": "sincronização já em andamento"}
    async with _lock:
        log_id = db.log_start()
        diag: dict | None = None
        try:
            records = await fetch_all_records(settings, ckan_transport)
            units, diag = normalize_records(records, settings)
            if not units:
                raise RuntimeError("Nenhuma unidade válida após a normalização.")

            geocoder = Geocoder(settings, db, geo_transport)
            geocoded = 0
            for u in units:
                if u["lat"] is None:
                    coords = await geocoder.geocode(u["address"], u["neighborhood"])
                    if coords:
                        u["lat"], u["lng"], u["geo_source"] = coords[0], coords[1], "geocoded"
                        geocoded += 1
            diag["geocoded"] = geocoded

            without_geo = sum(1 for u in units if u["lat"] is None)
            diag["without_geo"] = without_geo
            db.replace_units(units)  # só troca o snapshot se tudo acima deu certo
            db.log_finish(log_id, True, len(units), without_geo, None, diag)
            log.info("sync ok: %s unidades (%s sem coordenada)", len(units), without_geo)
            return {"ok": True, "units": len(units), "without_geo": without_geo, "geocoded": geocoded}
        except Exception as exc:  # noqa: BLE001 - registramos e mantemos o último snapshot bom
            log.exception("sync falhou")
            db.log_finish(log_id, False, 0, 0, str(exc), diag)
            return {"ok": False, "error": str(exc)}

import asyncio
import logging
import secrets
import time
from collections import defaultdict, deque
from contextlib import asynccontextmanager
from pathlib import Path

from fastapi import Depends, FastAPI, Header, HTTPException, Query, Request
from fastapi.middleware.cors import CORSMiddleware
from fastapi.responses import JSONResponse
from fastapi.staticfiles import StaticFiles

from .config import Settings, get_settings
from .db import Database
from .search import public_unit, search_units
from .sync import run_sync

logging.basicConfig(level=logging.INFO)
log = logging.getLogger("vemsus")

UNIT_TYPES = ["USF", "UBS", "Centro de Saúde", "Policlínica", "CAPS", "UPA", "SAMU", "Maternidade", "Hospital", "Centro Especializado"]
SERVICE_TAGS = [
    "Vacinação", "Urgência", "Atenção Básica", "Saúde Mental", "Saúde Bucal", "Saúde da Criança", "Saúde da Mulher",
    "Saúde do Idoso", "Farmácia", "Exames", "Curativos", "Pré-natal", "Planejamento Familiar", "Doenças Crônicas",
    "Reabilitação", "Especialidades", "Puericultura", "Hipertensão e Diabetes",
]


class State:
    db: Database
    units: list[dict] = []

    def reload(self) -> None:
        self.units = self.db.all_units()


def create_app(settings: Settings | None = None) -> FastAPI:
    cfg = settings or get_settings()
    state = State()

    async def _periodic():
        while True:
            await asyncio.sleep(cfg.sync_interval_hours * 3600)
            await run_sync(cfg, state.db)
            state.reload()

    @asynccontextmanager
    async def lifespan(_app: FastAPI):
        state.db = Database(cfg.database_path)
        state.reload()
        tasks = []
        if cfg.sync_on_startup:
            async def first():
                await run_sync(cfg, state.db)
                state.reload()
            tasks.append(asyncio.create_task(first()))
        if cfg.sync_interval_hours:
            tasks.append(asyncio.create_task(_periodic()))
        yield
        for t in tasks:
            t.cancel()

    app = FastAPI(title="VemSUS API", version="1.0.0", lifespan=lifespan, docs_url="/api/docs", openapi_url="/api/openapi.json")
    app.state.vemsus = state
    app.add_middleware(CORSMiddleware, allow_origins=cfg.cors_origins, allow_methods=["GET"], allow_headers=["*"])

    # --- limite de requisições por IP (só em memória; nenhum IP é gravado) e cabeçalhos de segurança
    hits: dict[str, deque] = defaultdict(deque)

    @app.middleware("http")
    async def guard(request: Request, call_next):
        if request.url.path.startswith("/api/"):
            ip = request.client.host if request.client else "?"
            if cfg.trust_proxy and request.headers.get("x-forwarded-for"):
                ip = request.headers["x-forwarded-for"].split(",")[0].strip()
            now, window = time.monotonic(), hits[ip]
            while window and now - window[0] > 60:
                window.popleft()
            if len(window) >= cfg.rate_limit_per_minute:
                return JSONResponse({"detail": "Muitas requisições. Tente de novo em instantes."}, status_code=429)
            window.append(now)
        response = await call_next(request)
        response.headers["X-Content-Type-Options"] = "nosniff"
        response.headers["Referrer-Policy"] = "no-referrer"
        response.headers["Permissions-Policy"] = "geolocation=(self), camera=(), microphone=()"
        if request.url.path.startswith("/api/"):
            response.headers["Cache-Control"] = "no-store"  # a query pode conter a localização do usuário
        return response

    @app.get("/api/health")
    def health():
        return {"status": "ok", "units_loaded": len(state.units)}

    @app.get("/api/units")
    def list_units(
        q: str = Query("", max_length=100),
        services: list[str] = Query(default=[]),
        type: str | None = Query(default=None, max_length=40),
        child: bool = False,
        lat: float | None = Query(default=None, ge=-90, le=90),
        lng: float | None = Query(default=None, ge=-180, le=180),
        limit: int = Query(default=200, ge=1, le=1000),
    ):
        if (lat is None) != (lng is None):
            raise HTTPException(422, "Informe lat e lng juntos.")
        if type and type not in UNIT_TYPES:
            raise HTTPException(422, "Tipo de unidade inválido.")
        bad = [s for s in services if s not in SERVICE_TAGS]
        if bad:
            raise HTTPException(422, f"Serviço desconhecido: {bad[0]}")
        total, units = search_units(state.units, q, services, type, child, lat, lng, limit)
        return {"total": total, "units": units}

    @app.get("/api/units/{unit_id}")
    def get_unit(unit_id: str):
        for u in state.units:
            if u["id"] == unit_id and u["lat"] is not None:
                return public_unit(u)
        raise HTTPException(404, "Unidade não encontrada.")

    @app.get("/api/services")
    def services():
        return {"services": SERVICE_TAGS, "unitTypes": UNIT_TYPES}

    @app.get("/api/meta")
    def meta():
        last = state.db.last_sync(only_ok=True)
        return {
            "source": "Prefeitura do Recife — Portal de Dados Abertos",
            "dataset": "Rede de atenção à saúde no Recife",
            "datasetUrl": f"{cfg.ckan_base_url}/dataset/rede-de-atencao-a-saude-no-recife",
            "license": "ODbL — Open Data Commons Open Database License",
            "unitsServed": sum(1 for u in state.units if u["lat"] is not None),
            "unitsWithoutLocation": sum(1 for u in state.units if u["lat"] is None),
            "approximateLocation": sum(1 for u in state.units if u["geo_source"] == "geocoded"),
            "lastSync": last["finished_at"] if last else None,
            "ready": bool(state.units),
        }

    def require_admin(x_admin_token: str | None = Header(default=None)):
        if not cfg.admin_token or not x_admin_token or not secrets.compare_digest(x_admin_token, cfg.admin_token):
            raise HTTPException(403, "Não autorizado.")

    @app.post("/api/admin/sync", dependencies=[Depends(require_admin)])
    async def admin_sync():
        result = await run_sync(cfg, state.db)
        state.reload()
        return result

    @app.get("/api/admin/diagnostico", dependencies=[Depends(require_admin)])
    def diagnostico():
        """Mostra o que o normalizador não reconheceu (valores de tipo_unidade, coordenadas inválidas...)."""
        return state.db.last_sync() or {}

    static = Path(cfg.static_dir).resolve() if cfg.static_dir else None
    if static and static.is_dir():
        app.mount("/", StaticFiles(directory=static, html=True), name="site")
    return app


app = create_app()

"""Transforma as linhas cruas do dataset (uma linha por unidade x serviço) em unidades do VemSUS."""
import hashlib
import re
import unicodedata
from collections import Counter, defaultdict

from .config import Settings
from .geo import validate_coords

NO_ADDRESS = "Informação não disponível na base oficial."


def fold(text) -> str:
    """minúsculas, sem acento, espaços normalizados."""
    if text is None:
        return ""
    txt = unicodedata.normalize("NFKD", str(text))
    txt = "".join(c for c in txt if not unicodedata.combining(c))
    return re.sub(r"\s+", " ", txt).strip().lower()


def clean(text) -> str:
    return re.sub(r"\s+", " ", str(text)).strip() if text is not None else ""


def _row(raw: dict) -> dict:
    """Chaves sem acento ('endereço' -> 'endereco'), para tolerar variações do portal."""
    return {fold(k).replace(" ", "_"): v for k, v in raw.items()}


# ---------------------------------------------------------------- tipo de unidade
# Ordem importa: do mais específico para o mais genérico. Usa palavras inteiras
# (o protótipo usava 'includes', e "upa" casava com "ocupacional").
TYPE_RULES: list[tuple[str, re.Pattern]] = [
    ("SAMU", re.compile(r"\bsamu\b|atendimento movel")),
    ("UPA", re.compile(r"\bupa\b|pronto atend")),
    ("CAPS", re.compile(r"\bcaps\b|psicossocial")),
    ("Maternidade", re.compile(r"maternidade")),
    ("Hospital", re.compile(r"hospital")),
    ("Policlínica", re.compile(r"policlinica")),
    ("USF", re.compile(r"\busf\b|saude da familia|\besf\b")),
    ("UBS", re.compile(r"\bubs\b|unidade basica|posto de saude")),
    ("Centro Especializado", re.compile(r"especializad|\bceo\b|\bcer\b|\bcem\b")),
    ("Centro de Saúde", re.compile(r"centro de saude")),
]


def detect_unit_type(tipo_unidade: str, nome: str) -> tuple[str, bool]:
    """Devolve (tipo, reconhecido). Procura primeiro no campo tipo_unidade, depois no nome."""
    for source in (fold(tipo_unidade), fold(nome)):
        for unit_type, pattern in TYPE_RULES:
            if source and pattern.search(source):
                return unit_type, True
    return "Centro de Saúde", False


# ---------------------------------------------------------------- serviços
SERVICE_RULES: list[tuple[str, re.Pattern]] = [
    ("Vacinação", re.compile(r"vacin|imuniza")),
    ("Urgência", re.compile(r"urgenc|emergenc|pronto atend|pronto.socorro")),
    ("Atenção Básica", re.compile(r"atencao basica|atencao primaria|saude da familia|clinico geral|clinica medica")),
    ("Saúde Mental", re.compile(r"mental|psicolog|psiquiatr|psicossocial")),
    ("Saúde Bucal", re.compile(r"bucal|odonto|dentist|dental")),
    ("Saúde da Criança", re.compile(r"crianca|pediatr|infantil")),
    ("Puericultura", re.compile(r"puericult")),
    ("Saúde da Mulher", re.compile(r"mulher|ginecolog|obstetr")),
    ("Saúde do Idoso", re.compile(r"idoso|geriatr")),
    ("Farmácia", re.compile(r"farmaci|dispensacao")),
    ("Exames", re.compile(r"exame|laborator|ultrassom|ultrasson|radiolog|raio.?x|diagnostic|patologia clinica|mamograf")),
    ("Curativos", re.compile(r"curativo")),
    ("Pré-natal", re.compile(r"pre.?natal")),
    ("Planejamento Familiar", re.compile(r"planejamento (familiar|reprodutivo)")),
    ("Doenças Crônicas", re.compile(r"cronic|hipertens|diabet")),
    ("Hipertensão e Diabetes", re.compile(r"hipertens|diabet")),
    ("Reabilitação", re.compile(r"reabilit|fisioterap|fonoaudi|terapia ocupacional")),
    (
        "Especialidades",
        re.compile(r"especialidade|cardiolog|ortoped|dermatolog|oftalmolog|neurolog|endocrin|urolog|otorrino|reumatolog|nefrolog|gastro|pneumolog"),
    ),
]

# Serviços inerentes ao tipo de unidade (documentado; NÃO é um "default" para todas as unidades).
TYPE_IMPLIED_SERVICES = {
    "USF": ["Atenção Básica"],
    "UBS": ["Atenção Básica"],
    "UPA": ["Urgência"],
    "SAMU": ["Urgência"],
    "CAPS": ["Saúde Mental"],
    "Policlínica": ["Especialidades"],
    "Centro Especializado": ["Especialidades"],
}


def detect_services(unit_type: str, service_texts: list[str]) -> list[str]:
    found: set[str] = set(TYPE_IMPLIED_SERVICES.get(unit_type, []))
    for text in service_texts:
        folded = fold(text)
        for tag, pattern in SERVICE_RULES:
            if pattern.search(folded):
                found.add(tag)
    order = {tag: i for i, (tag, _) in enumerate(SERVICE_RULES)}
    return sorted(found, key=lambda t: order.get(t, 99))


# ---------------------------------------------------------------- agrupamento
def _unique(values: list[str]) -> list[str]:
    seen, out = set(), []
    for v in values:
        key = fold(v)
        if v and key not in seen:
            seen.add(key)
            out.append(v)
    return out


def _unit_key(row: dict) -> str:
    cnes = clean(row.get("cnes"))
    cnes = re.sub(r"\.0+$", "", cnes)  # numeric vindo como 2400030.0
    if cnes and cnes != "0":
        return f"cnes-{cnes}"
    base = f"{fold(row.get('nome_oficial'))}|{fold(row.get('endereco'))}"
    return "h-" + hashlib.sha1(base.encode()).hexdigest()[:12]


def normalize_records(records: list[dict], settings: Settings) -> tuple[list[dict], dict]:
    """Agrupa as linhas por unidade. Devolve (unidades, diagnóstico).
    Unidades sem coordenada válida saem com lat/lng = None (o Geocoder tenta resolver depois)."""
    exclude = [fold(p) for p in settings.exclude_type_patterns.split(",") if p.strip()]
    groups: dict[str, list[dict]] = defaultdict(list)
    diag = {
        "rows": len(records),
        "rows_skipped_no_name": 0,
        "rows_skipped_excluded_type": 0,
        "unmapped_type_values": Counter(),
        "coords_fixed": 0,
        "coords_invalid": 0,
    }

    for raw in records:
        row = _row(raw)
        if not clean(row.get("nome_oficial")):
            diag["rows_skipped_no_name"] += 1
            continue
        if any(p in fold(row.get("tipo_unidade")) for p in exclude):
            diag["rows_skipped_excluded_type"] += 1
            continue
        groups[_unit_key(row)].append(row)

    units: list[dict] = []
    for key, rows in groups.items():
        first = rows[0]
        name = clean(first.get("nome_oficial"))
        tipo_raw = clean(first.get("tipo_unidade"))
        unit_type, recognized = detect_unit_type(tipo_raw, name)
        if not recognized:
            diag["unmapped_type_values"][tipo_raw or "(vazio)"] += 1

        address = next((clean(r.get("endereco")) for r in rows if clean(r.get("endereco"))), "")
        neighborhood = next((clean(r.get("bairro")) for r in rows if clean(r.get("bairro"))), "")
        phone = next((clean(r.get("fone")) for r in rows if clean(r.get("fone"))), "")
        schedule = " · ".join(_unique([clean(r.get("horario")) for r in rows]))
        how_to = " ".join(_unique([clean(r.get("como_usar")) for r in rows]))

        service_texts = [clean(r.get("tipo_servico")) for r in rows] + [clean(r.get("especialidade")) for r in rows]
        services = detect_services(unit_type, service_texts)

        coords = None
        for r in rows:
            coords = validate_coords(settings, r.get("latitude"), r.get("longitude"))
            if coords:
                raw_lat = r.get("latitude")
                if str(raw_lat).strip().replace(",", ".") != str(coords[0]):
                    diag["coords_fixed"] += 1
                break
        if not coords:
            diag["coords_invalid"] += 1

        units.append(
            {
                "id": key,
                "cnes": key[5:] if key.startswith("cnes-") else None,
                "name": name,
                "type": unit_type,
                "address": address or NO_ADDRESS,
                "neighborhood": neighborhood,
                "phone": phone or None,
                "schedule": schedule or None,
                "lat": coords[0] if coords else None,
                "lng": coords[1] if coords else None,
                "geo_source": "official" if coords else "missing",
                "services": services,
                "before_visit": how_to or None,
            }
        )

    diag["unmapped_type_values"] = dict(diag["unmapped_type_values"].most_common(30))
    diag["units"] = len(units)
    return units, diag

